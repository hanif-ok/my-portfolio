---
import "../styles/global.css";

interface Props {
  /** Page-specific part of the title. Omit on the home page. */
  title?: string;
  description?: string;
  /** Share image, relative to the site root. Defaults to the generated OG card. */
  image?: string;
  type?: "website" | "article";
  publishedTime?: string;
}

const SITE_NAME = "Hanif Omar Kertapati";
const SITE_ROLE = "Fullstack Engineer";
const DEFAULT_DESCRIPTION =
  "Fullstack engineer building internal tools — CRMs, dashboards, and the automation behind them. Next.js, Flutter, Supabase, n8n.";

const {
  title,
  description = DEFAULT_DESCRIPTION,
  image = "/images/og-cover.png",
  type = "website",
  publishedTime,
} = Astro.props;

const withBase = (assetPath: string) => `${import.meta.env.BASE_URL}${assetPath.replace(/^\/+/, "")}`;

// The name goes in every title: this is what shows in tabs, bookmarks,
// search results and the link previews recruiters paste around.
const pageTitle = title ? `${title} — ${SITE_NAME}` : `${SITE_NAME} — ${SITE_ROLE}`;

const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(withBase(image), Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE_NAME} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#e8ecef" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE_NAME} — ${SITE_ROLE}`} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:locale:alternate" content="id_ID" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <script is:inline>
      // Stamp the locale onto <html> before first paint, so the bilingual
      // content panes ([data-lang-pane] in global.css) render in the right
      // language immediately instead of flashing English first.
      // LocaleRuntime re-applies this on load and owns every switch; this only
      // removes the flash. With JS off nothing is stamped and EN is the
      // default, which is exactly the desired fallback.
      (function () {
        // Marks JS as available. The card fade-in in global.css is gated on
        // this, so with JS off the cards simply render rather than staying at
        // opacity 0 forever.
        document.documentElement.classList.add("js");
        try {
          var saved = localStorage.getItem("portfolio-locale");
          var locale =
            saved === "en" || saved === "id"
              ? saved
              : (navigator.language || "").toLowerCase().indexOf("id") === 0
                ? "id"
                : "en";
          document.documentElement.setAttribute("data-locale", locale);
        } catch (e) {
          document.documentElement.setAttribute("data-locale", "en");
        }
      })();
    </script>

    <link rel="icon" type="image/svg+xml" href={withBase("favicon.svg")} />
    <link rel="icon" href={withBase("favicon.ico")} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Syne:wght@700&family=DM+Sans:wght@400;500&family=JetBrains+Mono:wght@400&family=Nunito:wght@400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="portfolio-body">
    <slot />
  </body>
</html>
