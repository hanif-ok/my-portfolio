---
import { getCollection } from "astro:content";
import AboutSection from "../components/AboutSection.astro";
import BlogSection from "../components/BlogSection.astro";
import ContactSection from "../components/ContactSection.astro";
import FullSkillsSection from "../components/FullSkillsSection.astro";
import HeroNowRow from "../components/HeroNowRow.astro";
import LocaleRuntime from "../components/LocaleRuntime.astro";
import NavBar from "../components/NavBar.astro";
import ProjectsSection from "../components/ProjectsSection.astro";
import SandboxSection from "../components/SandboxSection.astro";
import WorkSection from "../components/WorkSection.astro";
import { HOME_COPY } from "../i18n/home";
import { groupSandbox } from "../lib/sandbox";
import BaseLayout from "../layouts/BaseLayout.astro";

const allBlogPosts = (
  await getCollection("blog", ({ data }) => !data.draft)
).sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const latestPosts = allBlogPosts.slice(0, 4);

const sandboxItems = groupSandbox(
  await getCollection("sandbox", ({ data }) => !data.draft)
);

// Both language twins are ordered by the EN twin's featuredOrder. Sorting each
// twin on its own value let the two drift, which silently reordered the
// carousel when you switched locale - the same trap lib/sandbox.ts avoids by
// construction.
const allProjects = await getCollection("projects", ({ data }) => data.featured);
const projectSlug = (entryId: string) => entryId.replace(/^(?:en|id)\//, "");
const canonicalOrder = new Map(
  allProjects
    .filter((project) => !project.id.startsWith("id/"))
    .map((project) => [
      projectSlug(project.id),
      project.data.featuredOrder ?? Number.MAX_SAFE_INTEGER,
    ])
);

const featuredProjects = allProjects.sort((a, b) => {
  const orderA = canonicalOrder.get(projectSlug(a.id)) ?? Number.MAX_SAFE_INTEGER;
  const orderB = canonicalOrder.get(projectSlug(b.id)) ?? Number.MAX_SAFE_INTEGER;

  if (orderA !== orderB) return orderA - orderB;
  return b.data.year - a.data.year;
});
---

<BaseLayout>
  <NavBar />
  <main class="portfolio-page">
    <div class="content-flow">
      <HeroNowRow />
      <AboutSection />
      <WorkSection />
      <ProjectsSection projects={featuredProjects} />
      <SandboxSection items={sandboxItems} />

      <BlogSection posts={latestPosts} totalCount={allBlogPosts.length} />

      <ContactSection />

      <FullSkillsSection />
    </div>
  </main>

  <LocaleRuntime dictionaries={HOME_COPY} />

  <script is:inline>
    (() => {
      const cards = Array.from(
        document.querySelectorAll(".paper-card, .footer-card")
      );

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.08, rootMargin: "0px 0px -20px 0px" }
      );

      let stagger = 0;
      const vh = window.innerHeight;

      cards.forEach((card) => {
        if (card.getBoundingClientRect().top < vh) {
          card.style.setProperty("--card-delay", `${stagger * 100}ms`);
          stagger++;
        }
        observer.observe(card);
      });
    })();
  </script>
</BaseLayout>
